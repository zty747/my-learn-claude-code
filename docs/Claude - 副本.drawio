          <mxGeometry x="496" y="3686" width="376" height="77.46" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-136" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;具体逻辑:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;对整个messages 处理，&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;是落盘然后截断（防止压缩超token）然后LLM压缩&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;重点来了，CC这里不一样：&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;会自动将最近使用过的 5 个文件重新附加到新的上下文数组中。&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="902" y="3627" width="255" height="153.16" as="geometry" />
