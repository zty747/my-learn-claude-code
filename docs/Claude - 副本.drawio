        <mxCell id="iaKIJlxI15cZCpAoIllr-189" value="" style="endArrow=classic;html=1;rounded=0;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="228.5" y="4061" as="sourcePoint" />
