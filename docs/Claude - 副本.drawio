        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-33" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="381.998695652174" y="10506.999130434784" width="717" height="88" as="geometry" />
        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-34" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Prompt 2: read readme.md(会触发模型返回tool_use都可以)&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" vertex="1" parent="1">
