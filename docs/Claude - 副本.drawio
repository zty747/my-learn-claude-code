        <mxCell id="pvZ-KqbLqHoGzjqvof50-31" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;第二次while true&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" vertex="1" parent="1">
