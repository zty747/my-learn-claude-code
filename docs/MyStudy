```python
def tool_result_budget(messages, max_bytes=200_000):
    last = messages[-1] if messages else None
    # ① 判断最后一条消息是否合法
    if not last or last.get("role") != "user" or not isinstance(last.get("content"), list):
        return messages
    # ② 从最后一条消息中提取所有工具结果块（type == "tool_result"）
    # 只处理最后一条消息因为之前的都处理过了 tool_result_budget是无条件执行的
    blocks = [(i, b) for i, b in enumerate(last["content"])
              if isinstance(b, dict) and b.get("type") == "tool_result"]
    total = sum(len(str(b.get("content", ""))) for _, b in blocks)
    # ③ 未超预算则不做任何处理
    if total <= max_bytes:
        return messages
    # ④ 超预算：按内容长度降序排列，优先压缩最大的结果
    ranked = sorted(blocks, key=lambda p: len(str(p[1].get("content", ""))), reverse=True)
    for _, block in ranked:
        if total <= max_bytes:
            break  # 预算已达标，停止压缩
        content = str(block.get("content", ""))
        if len(content) <= PERSIST_THRESHOLD:  # 小于 30K 的块不压缩
            continue
        tid = block.get("tool_use_id", "unknown")
        block["content"] = persist_large_output(tid, content)  # 用占位内容替换
        # 重新计算总大小
        total = sum(len(str(b.get("content", ""))) for _, b in blocks)
    return messages
```
