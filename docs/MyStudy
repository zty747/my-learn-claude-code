def write_transcript(messages):
    TRANSCRIPT_DIR.mkdir(parents=True, exist_ok=True)
    path = TRANSCRIPT_DIR / f"transcript_{int(time.time())}.jsonl"
    with path.open("w") as f:
        for msg in messages:
            f.write(json.dumps(msg, default=str) + "\n")
    return path

def summarize_history(messages):
    # 将消息序列化成 JSON 字符串，截取前 80000 字符
    conversation = json.dumps(messages, default=str)[:80000]
    prompt = (
        "Summarize this coding-agent conversation so work can continue.\n"
        "Preserve: 1. current goal, 2. key findings/decisions, 3. files read/changed, "
        "4. remaining work, 5. user constraints.\nBe compact but concrete.\n\n"
        + conversation
    )
    response = client.messages.create(
        model=MODEL,
        messages=[{"role": "user", "content": prompt}],
        max_tokens=2000
    )
    # 提取响应中的文本
    return "\n".join(
        getattr(block, "text", "")
        for block in response.content
        if getattr(block, "type", None) == "text"
    ).strip() or "(empty summary)"

def compact_history(messages):
    transcript_path = write_transcript(messages)  # 先备份完整对话
    print(f"[transcript saved: {transcript_path}]")
    summary = summarize_history(messages)         # 调用 LLM 生成摘要
    # 返回一个只包含一条 user 消息的新列表，代表压缩后的历史
    return [{"role": "user", "content": f"[Compacted]\n\n{summary}"}]
```


**业务逻辑**：
- **备份**：将当前全部消息列表写入 `.transcripts/transcript_<时间戳>.jsonl` 文件中持久化，避免信息丢失。
- **摘要生成**：
    - 将消息列表序列化为 JSON，截断至 80000 字符（避免摘要请求本身超出 token 限制）。
    - 构造提示词，明确要求保留五类关键信息：当前目标、关键发现/决策、已读/改的文件、剩余工作、用户约束。
    - 调用同一个模型生成摘要（`max_tokens=2000`），确保摘要精炼。
    - 如果模型返回空内容，则回退为 `"(empty summary)"`。
- **替换历史**：返回一个只含==一条 `user` 消息==的新列表，内容为 `[Compacted]` 加上摘要文本。这个列表将**彻底替换**原有的所有消息，从而将上下文缩小到一条消息的长度。
**条件分支**：
- 无显著条件分支，唯一处理是当摘要内容为空时使用默认字符串，防止空消息。

