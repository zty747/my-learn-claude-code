        <mxCell id="pvZ-KqbLqHoGzjqvof50-182" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;1.LLM request，就是sys+prompt，这里略（最后一章完整终结一下，如load memory）&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
