        <mxCell id="iaKIJlxI15cZCpAoIllr-158" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;首轮对话，第0个箭头没有体现，prompt:I prefer using tabs for indentation, not spaces. Remember that.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
