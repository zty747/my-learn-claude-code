        <mxCell id="pvZ-KqbLqHoGzjqvof50-221" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;这里返回的是所有满足条件的，在idle_poll中只会取一个&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
