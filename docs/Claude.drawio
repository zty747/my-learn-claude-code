        <mxCell id="iaKIJlxI15cZCpAoIllr-113" value="&lt;span style=&quot;color: rgb(0, 0, 204); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;把skill的name和describe注入system prompt。&lt;/span&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;CC中还会注入更多信息&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="232" y="2280" width="268" height="101" as="geometry" />
