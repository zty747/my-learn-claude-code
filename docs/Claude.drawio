        <mxCell id="pvZ-KqbLqHoGzjqvof50-48" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Prompt 1: Spawn alice as a backend developer. Ask her to create a file called schema.sql with a users table.&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-242" y="11731" width="254" height="57" as="geometry" />
