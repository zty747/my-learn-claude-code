        <mxCell id="iaKIJlxI15cZCpAoIllr-137" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 204);&quot;&gt;在提交给LLM压缩，注意3，4才会完整落盘，12都会损失信息 所以要先3后12&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="136" y="3402" width="353" height="32" as="geometry" />
        </mxCell>
