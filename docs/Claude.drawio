        <mxCell id="iaKIJlxI15cZCpAoIllr-209" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-104" y="5526" width="748" height="395.23" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-211" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;引入新的数据结构context,记录真实状态来更新system prompt&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;context 只在两个地方被重新计算：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;1. 程序启动时 / 每个用户输入处理前和后：main 里调用 update_context()&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;2. 每次工具执行完一轮后：agent_loop 里调用 update_context()&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 204);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="44" y="5925" width="238.75" height="130" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-212" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="107.2" y="6083" width="351.8" height="71.54" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-213" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-603" y="5921.23" width="379.5" height="129.27" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-216" value="" style="line;strokeWidth=2;direction=south;html=1;" parent="1" vertex="1">
          <mxGeometry x="2" y="5921.23" width="10" height="1457.77" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-217" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: rgb(255, 51, 51);&quot;&gt;程序启动时（没有用户输入）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;div style=&quot;color: rgb(0, 0, 204);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-153.7" y="6125" width="163.9" height="29" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-218" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;update_context()&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="6123" width="110" height="29" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-220" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;system = get_system_prompt(context_0)生成cache key&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;这是第一次调用，_last_context_key is None，缓存 miss。&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;所以调用assemble_system_prompt(context_0)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;assemble中&lt;/span&gt;此时 memories == &quot;&quot;，&lt;/div&gt;&lt;div&gt;所以只加载：context中identity，&lt;span style=&quot;background-color: transparent;&quot;&gt;tools，&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;workspace&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="10" y="6196" width="331" height="81" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-221" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-596" y="6083" width="327" height="230.95" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-222" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-594" y="6328" width="387" height="203.65" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-223" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Prompt 1: Read the file README.md&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-199" y="6211" width="209" height="29" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-224" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;`update_context` 负责**感知现实**：检查磁盘上 `.memory/MEMORY.md` 是否存在及有内容，收集全局工具表、工作目录，打包成字典&lt;/font&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;context&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 204); background-color: transparent;&quot;&gt;。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;它完全忽略传入的 context 和 messages，确保上下文不会被过时状态污染，每一次都重新基于事实生成。这里似乎只看memory_index，cc应该会用到messages吧&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 204);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-844" y="5920.5" width="238.75" height="130" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-225" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;负责**高效获取与缓存**：将上下文序列化为键，只在变化时才调用 `assemble_system_prompt` 重新构建，否则直接返回上次结果，并提供日志可见性。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;重点是assemble_system_prompt由它调用&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 204);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-850" y="6088" width="238.75" height="130" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-226" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;负责**按需组装**：根据字典中的字段，无条件添加身份/工具/工作空间片段，有条件地添加记忆片段。。&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;div style=&quot;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;重点是实际把context这个字典变为&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(0, 0, 204);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;system_prompt&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="-850" y="6318" width="238.75" height="130" as="geometry" />
        </mxCell>
        <mxCell id="iaKIJlxI15cZCpAoIllr-227" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
