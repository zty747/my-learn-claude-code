        <mxCell id="pvZ-KqbLqHoGzjqvof50-34" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Prompt 2: read readme.md(会触发模型返回tool_use都可以)&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
