        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-226" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;这里是下一个&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;work cycle/&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;agent turn&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="1130" y="20089" width="145" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-227" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;claim不仅是在agent step中的工具，还是在work cycle的&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;idle阶段中&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;scan到可用任务时也会执行。&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;所以似乎有两条执行看板任务的方式，一是在agent step1 LLM调用list_task拿到所有任务后agent step2 LLM调用claim_task取走一个可用任务然后&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;agent step3执行任务然后&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;agent step4 complete_task&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;二是work cycle1中 agent step1没有调用工具进入idle阶段scan出可用任务并&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;调用claim_task取走一个可用任务&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(255, 51, 51);&quot;&gt;进入&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(255, 51, 51);&quot;&gt;work cycle2的&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;agent step1执行任务,&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51); background-color: transparent;&quot;&gt;agent step2 complete_task&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
          <mxGeometry x="1652" y="19540.4" width="302" height="169.6" as="geometry" />
        </mxCell>
