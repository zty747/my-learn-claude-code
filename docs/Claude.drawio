        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-200" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#ff3333&quot;&gt;这三个都是lead和teammate共有的的工具函数，而左边栏的是在idle阶段必然执行的函数idle_poll和scan&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
