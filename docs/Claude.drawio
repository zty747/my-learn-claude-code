        <mxCell id="iaKIJlxI15cZCpAoIllr-133" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font color=&quot;#0000cc&quot;&gt;真实cc这里还有一个contextCollapse&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
