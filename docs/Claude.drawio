        </mxCell>
        <mxCell id="pvZ-KqbLqHoGzjqvof50-52" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;lead第一个tool round，加上左边的就是第一个agent step了&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;rotation=0;" parent="1" vertex="1">
